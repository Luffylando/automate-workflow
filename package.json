{
  "name": "automate-workflow",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh start",
    "stop": "bash scripts/dev.sh stop",
    "restart": "bash scripts/dev.sh restart",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "db:setup": "bash scripts/db-setup.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "start:api": "pnpm --filter api start",
    "start:web": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test && pnpm --filter api test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
